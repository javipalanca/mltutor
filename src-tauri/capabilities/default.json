{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window: MLTutor's own commands, the native open/save dialogs and writing only the files the user picks in the save dialog (no static filesystem scope).",
  "windows": ["main"],
  "permissions": [
    "allow-launch-mode",
    "allow-frontend-ready",
    "allow-screenshot-ready",
    "allow-smoke-route-rendered",
    "allow-smoke-check-passed",
    "allow-smoke-failed",
    "allow-smoke-panic-probe",
    "allow-log-message",
    "allow-list-datasets",
    "allow-get-selected-dataset",
    "allow-select-dataset",
    "allow-dataset-summary",
    "allow-dataset-preview",
    "allow-dataset-describe",
    "allow-target-distribution",
    "allow-correlation-matrix",
    "allow-pairplot-data",
    "allow-load-csv",
    "allow-csv-target-info",
    "allow-set-csv-target",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
