{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window: only MLTutor's own commands. The open/save dialogs and the file access happen in Rust (pick_and_load_csv, save_file), so the frontend gets no dialog or filesystem permission.",
  "windows": ["main"],
  "permissions": [
    "allow-launch-mode",
    "allow-frontend-ready",
    "allow-screenshot-ready",
    "allow-smoke-route-rendered",
    "allow-smoke-check-passed",
    "allow-smoke-failed",
    "allow-smoke-panic-probe",
    "allow-log-message",
    "allow-list-datasets",
    "allow-get-selected-dataset",
    "allow-select-dataset",
    "allow-dataset-summary",
    "allow-dataset-preview",
    "allow-dataset-describe",
    "allow-target-distribution",
    "allow-correlation-matrix",
    "allow-pairplot-data",
    "allow-cancel-task",
    "allow-pick-and-load-csv",
    "allow-load-scenario-csv",
    "allow-csv-target-info",
    "allow-set-csv-target",
    "allow-discard-csv",
    "allow-save-file"
  ]
}
