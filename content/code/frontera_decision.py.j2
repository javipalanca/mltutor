{%- set todos = datos is defined and datos == "todos" %}
{%- set Xd = "X" if todos else "X_train" %}
{%- set yd = "y" if todos else "y_train" -%}
import numpy as np
import matplotlib.pyplot as plt
from sklearn.base import clone
from sklearn.inspection import DecisionBoundaryDisplay

{% if todos %}# Necesita X, y y modelo (el script de "📄 Código de Entrenamiento")
# Como MLTutor en KNN: TODAS las muestras del dataset (no solo las de entrenamiento),
# solo con las 2 características elegidas
{% else %}# Necesita X_train, y_train y modelo (el script de "📄 Generar Código")
# Datos de entrenamiento: solo las 2 características elegidas
{% endif %}X_2d = np.asarray({{ Xd }}, dtype=float)[:, {{ feature_indices | pyrepr }}]

{% if todos %}# Modelo simplificado: el mismo KNN (n_neighbors, weights y metric), solo con esas 2
# características. Un KNN solo guarda las muestras: la frontera depende de cuáles le des
{% else %}# Entrenar el modelo simplificado: mismo tipo e hiperparámetros (en la logística, también
# solver="newton-cholesky", como MLTutor), solo con esas 2 características
{% endif %}model_2d = clone(modelo)
model_2d.fit(X_2d, {{ yd }})

# Crear figura
fig, ax = plt.subplots(figsize=(14, 10))

# Visualizar frontera de decisión usando sklearn
disp = DecisionBoundaryDisplay.from_estimator(
    model_2d,
    X_2d,
    response_method="predict",
    alpha=0.6,
    ax=ax,
    grid_resolution=200
)

# Añadir puntos de datos sobre la frontera
scatter = ax.scatter(
    X_2d[:, 0], 
    X_2d[:, 1], 
    c={{ yd }}, 
    edgecolors='black', 
    s=60,
    alpha=0.8
)

# Configurar etiquetas de los ejes
feature_names = {{ feature_names | pyrepr }}
if len(feature_names) >= 2:
    ax.set_xlabel(feature_names[0])
    ax.set_ylabel(feature_names[1])
else:
    ax.set_xlabel("Característica 1")
    ax.set_ylabel("Característica 2")

# Añadir leyenda de clases
class_names = {{ class_names | pyrepr }}
if class_names:
    legend_labels = class_names
else:
    legend_labels = [f"Clase {i}" for i in range(len(np.unique({{ yd }})))]

# Crear leyenda para las clases
handles, _ = scatter.legend_elements()
ax.legend(handles, legend_labels, title="Clases", loc="best")

ax.set_title("Frontera de Decisión")
plt.tight_layout()
plt.show()

