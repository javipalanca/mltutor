# Entrenar el modelo simplificado: mismo tipo e hiperparámetros, solo con esas 2 características
model_2d = clone(modelo)
model_2d.fit(X_2d, y_train)

# Crear figura
fig, ax = plt.subplots(figsize=(14, 10))

# Visualizar frontera de decisión usando sklearn
