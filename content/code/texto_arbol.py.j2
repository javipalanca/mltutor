from sklearn.tree import export_text

def get_tree_text(model, feature_names, class_names=None):
    """
    Obtiene una representación de texto de un árbol de decisión.

    Parameters:
    -----------
    model : DecisionTreeClassifier o DecisionTreeRegressor
        Modelo de árbol entrenado
    feature_names : list
        Nombres de las características
    class_names : list o dict, optional
        Nombres de las clases (solo para clasificación): una lista en el orden de sus códigos
        0, 1, 2... o un diccionario {valor de la clase: nombre}, necesario si las clases son
        números que no son 0, 1, 2... (por ejemplo, 3 y 6 en un CSV).
        Sin ellos, las hojas muestran el código de la clase ("class: 0").

    Returns:
    --------
    str
        Representación de texto del árbol
    """
    nombres_clase = None
    if class_names is not None and hasattr(model, "classes_"):
        # export_text quiere un nombre por cada clase que vio el modelo, en el orden de classes_
        if isinstance(class_names, dict):
            nombres_clase = [str(class_names[c]) for c in model.classes_]
        else:
            nombres_clase = [str(class_names[int(c)]) for c in model.classes_]
    return export_text(
        model,
        feature_names=feature_names,
        class_names=nombres_clase,
        show_weights=True
    )

# Ejemplo de uso:
tree_text = get_tree_text(tree_model, feature_names, class_names)
print(tree_text)

