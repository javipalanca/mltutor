from sklearn.tree import export_text

def get_tree_text(model, feature_names, class_names=None):
    """
    Obtiene una representación de texto de un árbol de decisión.

    Parameters:
    -----------
    model : DecisionTreeClassifier o DecisionTreeRegressor
        Modelo de árbol entrenado
    feature_names : list
        Nombres de las características
    class_names : dict, optional
        Solo para clasificación: el diccionario {valor de la clase: nombre} (nombre_clase en el
        script de entrenamiento). Una lista en el orden de los códigos solo se acepta si las
        clases del modelo son 0, 1, 2...
        Sin ellos, las hojas muestran el código de la clase ("class: 0").

    Returns:
    --------
    str
        Representación de texto del árbol
    """
    nombres_clase = None
    if class_names is not None and hasattr(model, "classes_"):
        if not isinstance(class_names, dict):
            # Una lista (nombres en el orden de los códigos) solo vale si las clases del modelo
            # son 0, 1, 2...; con otros valores (1, 2, 3 en un CSV) daría el nombre de otra clase
            if model.classes_.tolist() != list(range(len(model.classes_))):
                raise ValueError(
                    "class_names es una lista, pero las clases del modelo son "
                    f"{model.classes_.tolist()}: pasa el diccionario nombre_clase "
                    "{valor de la clase: nombre} del script de entrenamiento")
            class_names = dict(enumerate(class_names))
        # export_text quiere un nombre por cada clase que vio el modelo, en el orden de classes_
        nombres_clase = [str(class_names[c]) for c in model.classes_]
    return export_text(
        model,
        feature_names=feature_names,
        class_names=nombres_clase,
        show_weights=True
    )

# Ejemplo de uso, a continuación del script de entrenamiento: tree_model es su modelo,
# feature_names sus nombres y nombre_clase el diccionario {valor de la clase: nombre}
# (None en regresión)
tree_text = get_tree_text(tree_model, feature_names, nombre_clase)
