import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.metrics import confusion_matrix

# Todas las clases del dataset, en orden (nombre_clase es {valor de la clase: nombre}, del script
# de entrenamiento): una clase que no aparezca en la prueba sale con su fila y su columna a cero
todas = sorted(nombre_clase)
nombres_clases = [nombre_clase[c] for c in todas]

# Calcular la matriz de confusión
cm = confusion_matrix(y_test, y_pred, labels=todas)

# Crear el gráfico
fig, ax = plt.subplots(figsize=(8, 6))
sns.heatmap(cm, annot=True, fmt="d", cmap="Blues", ax=ax,
            xticklabels=nombres_clases, yticklabels=nombres_clases)
ax.set_xlabel('Predicción')
ax.set_ylabel('Real')
ax.set_title('Matriz de Confusión')

plt.tight_layout()
plt.show()
