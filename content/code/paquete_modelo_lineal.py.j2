    que exporta la lección 📊 Regresión. Lee modelo.json, reconstruye el objeto de
    scikit-learn sin reentrenar, comprueba que predice lo mismo que MLTutor y lo guarda en
    formato pickle. Contexto: estimator, dataset, classifier (bool), json_name, pkl_name.
    `dataset` es texto del usuario (nombre de un CSV): va con `pycomment` dentro del docstring. -#}
"""
Reconstruye el modelo entrenado en MLTutor como un objeto de scikit-learn.

Modelo: {{ estimator }}
Dataset: {{ dataset | pycomment }}

Uso (en la carpeta donde has descomprimido el ZIP):
    pip install scikit-learn numpy
    python reconstruir_modelo.py

Genera '{{ pkl_name }}', que puedes cargar con pickle o joblib.
"""
import json
import pickle

import numpy as np
{% if classifier %}from sklearn.linear_model import LogisticRegression{% else %}from sklearn.linear_model import LinearRegression{% endif %}

# 1. Leer los parámetros que ha aprendido MLTutor
with open("{{ json_name }}", encoding="utf-8") as f:
    datos = json.load(f)

# 2. Crear el modelo con los mismos hiperparámetros
{% if classifier %}modelo = LogisticRegression(**datos["params"])
{% else %}modelo = LinearRegression(**datos["params"])
{% endif %}
# 3. Copiar los parámetros aprendidos (no hace falta volver a entrenar)
modelo.coef_ = np.array(datos["coef_"], dtype=float)
modelo.intercept_ = {% if classifier %}np.array(datos["intercept_"], dtype=float){% else %}float(datos["intercept_"]){% endif %}
modelo.n_features_in_ = datos["n_features_in"]
{% if classifier %}modelo.classes_ = np.array(datos["classes_"])
modelo.n_iter_ = np.array(datos["n_iter_"], dtype=np.int32)
{% endif %}
# 4. Comprobar que el modelo reconstruido predice lo mismo que MLTutor
X = np.array(datos["check"]["X"], dtype=float)
{% if classifier %}assert np.array_equal(modelo.predict(X), np.array(datos["check"]["prediction"]))
assert np.allclose(modelo.predict_proba(X), datos["check"]["probabilities"], atol=1e-6)
{% else %}assert np.allclose(modelo.predict(X), datos["check"]["prediction"], rtol=1e-6, atol=1e-9)
{% endif %}print("✅ El modelo reconstruido predice lo mismo que MLTutor")

# 5. Guardar el modelo en formato pickle
with open("{{ pkl_name }}", "wb") as f:
    pickle.dump(modelo, f)
print("💾 Modelo guardado en '{{ pkl_name }}'")

