import matplotlib.pyplot as plt
from sklearn.tree import plot_tree

# Suponiendo que ya tienes un modelo entrenado (tree_model), los nombres de las características
# (feature_names) y, en clasificación, el diccionario nombre_clase {valor de la clase: nombre}
# del script de entrenamiento (None en regresión)

fig, ax = plt.subplots(figsize=(14, 10))

plot_tree(
    tree_model,
    feature_names=feature_names,
    # Solo para clasificación: un nombre por clase, en el orden de tree_model.classes_
    class_names=None if nombre_clase is None else [str(nombre_clase[c]) for c in tree_model.classes_],
    filled=True,
    rounded=True,
    ax=ax,
    proportion=True,
    impurity=True
)

plt.tight_layout()
plt.show()

