    print(f"  P({nombre_clase[c]}) = {p:.4f}")
{%- else %}
print(f"\nValor predicho: {prediccion:.4f} ({% if weights == "distance" %}media ponderada{% else %}media{% endif %} de los valores de los vecinos)")
